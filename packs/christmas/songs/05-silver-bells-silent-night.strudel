---
name: "Silver Bells / Silent Night"
bpm: 100
created: 2026-11-03
tags: [cover, christmas, glitch-hop]
---
// Silver Bells (Jay Livingston & Ray Evans, 1950) meets Silent Night (Franz Xaver Gruber, 1818).
// Rec Room (STN-05) snowglobe glitch-hop in Bb major / G minor at 100 BPM.
// Both melodies share the 8-bar I - IV - V - I / vi - IV - V - I progression
// (Bb - Eb - F - Bb - Gm - Eb - F - Bb): "Silver Bells" drives the syncopated
// city-sidewalk bounce on epiano, square lead and talking bitcrushed bass while
// "Silent Night" floats above in 4/4 dotted-quarter phrasing ([11@3 12 11@2 9@2])
// on glockenspiel, tubular bells and choir, locking together in counterpoint on the drops.
//
// FORM (100 BPM · 1 cycle = 1 bar · 80 bars = 3:12):
//   intro    8  e1  snowglobe music-box "Silent Night" on glockenspiel, choir pad, sub, morse
//   verse    8  e2  swung 808/909 glitch-hop beat, talking saw bass, "City sidewalks" on epiano
//   build    8  e3  "Silver bells" hook fragments, bitcrushed pluck stutter arp, snare roll
//   drop    12  e5  full glitch-hop chorus ("Silver bells / Ring-a-ling") + "Silent Night" bell answers
//   verse2   8  e3  second verse with chopped bitcrushed ear-candy arps and bell counter-chimes
//   break    8  e1  snowglobe calm: cathedral tubular bells + choir play "Silent Night", morse ping
//   build2   8  e3  both themes interleave over snare rush, ops-room klaxon and countdown tick
//   final   12  e5  full double-melody counterpoint ("Silent Night" on bells/trumpet + "Silver Bells" lead)
//   outro    8  e1  music-box "Sleep in heavenly peace", tubular bell toll, morse stand-down
// Degrees are from Bb3:major so none go negative: 7 = Bb4, 9 = D5, 11 = F5, 14 = Bb5.

setbpm(100);

"<intro@2 verse@2 build@2 drop@3 verse2@2 break@2 build2@2 final@3 outro@2>".slow(4).pickRestart({
  intro: stack(
    // deep sine sub anchoring Bb - Eb - F - Bb
    note("<bb1@2 eb1@2 f1@2 bb1@2>").s("sine").lpf(145).attack(0.04).release(0.4).gain(0.32),
    // warm snowglobe choir pad (clean triads so bell overtones ring without semitone rubs)
    chord("<Bb Eb F Bb Gm Eb F Bb>").voicing().s("wt_choir")
      .attack(0.8).release(1.6).hpf(180).lpf(1600).room(0.7).gain(0.15),
    // "Silent Night" in 4/4 dotted-quarter phrasing on music-box glockenspiel
    note("<[11@3 12 11@2 9@2] [11@3 12 11@2 9@2] [15@3 15 15@2 13@2] [14@3 14 14@2 11@2] [12@3 12 14@2 13 12] [11@3 12 11@2 9@2] [15@3 16 15@2 13@2] [14@6 ~@2]>")
      .scale("Bb3:major").s("glockenspiel")
      .hpf(400).lpf(5200).decay(0.55).sustain(0.15).release(0.45)
      .room(0.6).roomsize(0.75).pan(0.56).gain(0.24),
    // morse ping on bars 1 and 5
    note("<[c7 ~ c7 c7 ~ ~ ~ ~] ~ ~ ~ [c7 c7 ~ c7 ~ ~ ~ ~] ~ ~ ~>")
      .s("square").decay(0.03).sustain(0).hpf(2200).gain(0.07).pan(0.25),
    // radio static on the last beat of the section
    s("<~@7 [~ ~ ~ white]>").bpf(1800).bandq(6).coarse(6).decay(0.12).sustain(0).gain(0.11).pan(0.8)
  ),
  verse: stack(
    // swung 808 kick + 909 snare with glitch ghost notes
