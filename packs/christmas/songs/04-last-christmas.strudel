---
name: "Last Christmas (Wham!)"
bpm: 92
created: 2026-11-02
tags: [cover,christmas]
---
// Last Christmas — Wham! (1984), written by George Michael. Cover, transcribed from
// WHAM.Last Christmas k.mid with the MIDI Lab; melody, riff and changes from that transcription.
// Rearranged as a slow synth cover for the album closer: good night from the ops room.
// D major, D D Bm Bm Em Em A A all the way through.
//
// FORM (92 BPM · 1 cycle = 1 bar · 84 bars ≈ 3:39):
//   intro    8  e1  warm pad, sub, a pluck on the beat; the hook hinted on epiano
//   verse    8  e2  + slow 808 kick and rim, pulsing bass, the verse on epiano
//   lift     4  e3  hats to 16ths, snare roll, klaxon and tick, "last" on the pickup
//   chorus  16  e5  the only big one: full 808, sleigh bells, square lead + glock, choir;
//                   the second half is the synth riff
//   verse2   8  e2  back to the verse, a pulse arp under it
//   refrain  8  e3  the chorus on tubular bells and choir, half kit
//   bridge  16  e1  drums out: strings, an arp, the riff on bells in half time
//   outro   16  e1  pulse for four bars, then one bell sings the chorus and the riff home
// hook: the chorus line "Last Christmas I gave you my heart" and the falling synth riff.

setbpm(92);

"<intro@2 verse@2 lift chorus@4 verse2@2 refrain@2 bridge@4 outro@4>".slow(4).pickRestart({
  intro: stack(
    // pad
    chord("<D D Bm Bm Em Em A A>").voicing().s("gm_pad_warm")
      .attack(1.5).release(2.5).lpf(800).room(0.7).gain(0.24),
    // sub on the root
    note("<d1 d1 b0 b0 e1 e1 a0 a0>").s("sine").attack(0.8).release(1.5).gain(0.36),
    // pluck on the beat
    chord("<D D Bm Bm Em Em A A>").voicing().arp("<up down>").segment(4)
      .s("wt_pluck").decay(0.2).sustain(0).lpf(1600).room(0.5).gain(0.16).pan(0.6),
    // the hook, hinted
    note("<~ ~ ~ ~ [~ e5@2 d5@2 a4 ~ ~] ~ [~ c#5@2 a4@5] ~>")
      .s("gm_epiano1").release(0.6).delay(0.4).delaytime(0.489).delayfeedback(0.45)
      .room(0.5).gain(0.3).pan(0.45),
    // morse ping on bar 1
    note("<[c7 c7 ~ c7 c7 c7 ~ ~] ~@7>").s("square").decay(0.03).sustain(0).hpf(2000).gain(0.08).pan(0.25),
    // radio static on the last beat of the section
    s("<~@7 [~ ~ ~ white]>").bpf(1800).bandq(6).coarse(6).decay(0.12).sustain(0).gain(0.12).pan(0.8)
  ),
  verse: stack(
    // slow 808 kick and rim
    s("bd ~ ~ bd ~ ~ ~ ~").bank("RolandTR808").gain(0.8),
    s("~ ~ rim ~ ~ ~ rim ~").bank("RolandTR808").gain(0.32).pan(0.55),
    // pulsing bass, ducked on the kick
    note("<[d1 d2]*4 [d1 d2]*4 [b0 b1]*4 [b0 b1]*4 [e1 e2]*4 [e1 e2]*4 [a0 a1]*4 [a0 a1]*4>")
      .s("sawtooth").lpf(480).lpenv(1.2).decay(0.12).sustain(0.25)
      .gain("0.24 0.4 0.4 0.24 0.4 0.4 0.4 0.4"),
    // the verse on epiano
    note("<[~ e5 d5 ~ d5 a5@3] [f#5 [~ e5] d5@4 e5 e5] [e5 e5 d5@2 d5 b5 b5@2] [f#5@2 e5@2 d5@3 f#5] [[b4 d5] ~ e5@4 f#5 f#5] [f#5 d5 e5@4 c#5 d5] [c#5 [d5 c#5] d5@2 c#5 ~ d5 c#5] [b4 a4@7]>")
      .s("gm_epiano1").release(0.5).delay(0.35).delaytime(0.489).delayfeedback(0.4)
      .room(0.4).gain(0.32).pan(0.45),
    // pad
    chord("<D D Bm Bm Em Em A A>").voicing().s("gm_pad_warm")
      .attack(1.0).release(2.0).lpf(900).room(0.6).gain(0.2),
    // radio static on the last beat of the section
    s("<~@7 [~ ~ ~ white]>").bpf(1800).bandq(6).coarse(6).decay(0.12).sustain(0).gain(0.12).pan(0.8)
  ),
  lift: stack(
    s("bd ~ ~ bd ~ ~ bd ~").bank("RolandTR808").gain(0.8),
    s("~ ~ rim ~ ~ ~ rim ~").bank("RolandTR808").gain(0.32).pan(0.55),
    s("<hh*8 hh*8 hh*16 hh*16>").bank("RolandTR808").gain(0.16).pan(0.4),
    // snare roll into the chorus
    s("<~ [~ ~ ~ sd*4] [sd*4 ~ sd*4 sd*4] [sd*8 sd*16]>").bank("RolandTR808")
      .velocity(saw.range(0.2, 0.8).slow(4)).gain(0.4).pan(0.5),
    note("<[e1 e2]*4 [e1 e2]*4 [a0 a1]*4 [a0 a1]*4>")
      .s("sawtooth").lpf(560).lpenv(1.4).decay(0.12).sustain(0.25)
      .gain("0.24 0.4 0.4 0.24 0.4 0.4 0.24 0.4"),
    // the riff climbs, then "last" on the pickup
    note("<[~ ~ b4 ~ e5@4] [~ ~ a4 b4 c#5 d5 e5@2] [~ ~ c#5 ~ e5@4] [~@6 e5@2]>")
      .s("square").lpf(2400).decay(0.15).sustain(0.4).release(0.1)
      .delay(0.35).delaytime(0.489).delayfeedback(0.45).gain(0.22).pan(0.45),
    chord("<Em Em A A>").voicing().s("wt_strings")
      .attack(0.4).release(1.0).lpf(saw.range(900, 2200).slow(4)).room(0.5).gain(0.2),
    // klaxon: two detuned saws a fifth apart, swelling over the last two bars
    note("<~@2 [a2,e3]@2>").s("sawtooth").superimpose(x => x.detune(0.12)).vib(5).vibmod(0.3)
      .attack(1.5).sustain(1).release(0.4).lpf(400).lpenv(2.6).lpattack(4.0).lpsustain(1).gain(0.035).pan(0.3),
    // countdown tick on every beat of the last bar, hard left
    s("<~@3 rim*4>").coarse(8).gain(0.1).pan(0),
    // radio static on the last beat of the section
    s("<~@3 [~ ~ ~ white]>").bpf(1800).bandq(6).coarse(6).decay(0.12).sustain(0).gain(0.12).pan(0.8)
  ),
  chorus: stack(
    // full 808: kick, clap on 2 and 4, 16th hats, open hat, crash every 8 bars
    s("bd ~ ~ bd ~ ~ bd ~").bank("RolandTR808").gain(0.85),
    s("~ cp ~ cp").bank("RolandTR808").room(0.4).gain(0.45).pan(0.55),
    s("hh*16").bank("RolandTR808").velocity("[0.9 0.5 0.7 0.5]*4").gain(0.15).pan(sine.range(0.35, 0.65)),
    s("~ ~ ~ ~ ~ ~ oh ~").bank("RolandTR808").gain(0.12).pan(0.3),
    s("cr ~ ~ ~").bank("RolandTR808").gain(0.2).pan(0.6).slow(8),
    // sleigh bells on 8ths
    s("sleighbells*8").gain(0.12).pan(0.75),
    note("<[d1 d2]*4 [d1 d2]*4 [b0 b1]*4 [b0 b1]*4 [e1 e2]*4 [e1 e2]*4 [a0 a1]*4 [a0 a1]*4>")
      .s("sawtooth").lpf(640).lpenv(1.6).decay(0.12).sustain(0.25)
      .gain("0.24 0.4 0.4 0.24 0.4 0.4 0.24 0.4"),
    // square lead: the chorus, then the riff
    note(`<[~ e5@2 d5@2 a4 e5 e5] [f#5 d5@3 b4 b4 e5 e5] [f#5@2 d5@3 b4 c#5 d5] [c#5 b4@5 f#5@2]
           [~ e5@4 b4 f#5 g5] [f#5 e5@4 d5 c#5 d5] [c#5 c#5@2 d5@2 c#5@2 a4] [~ c#5@2 a4@5]
           [~ ~ a5@3 a4 ~ ~] [~ ~ a4 b4 c#5 d5 e5@2] [d5@2 b4@6] [~ ~ a5 f#5 d5 b4 g4@2]
           ~ [~ ~ b5 g5 e5 c#5 a4@2] ~ [~ ~ g4 f#4 e4 ~ d4@2]>`)
      .s("square").lpf(2800).decay(0.15).sustain(0.45).release(0.1)
      .delay(0.35).delaytime(0.489).delayfeedback(0.45).gain(0.22).pan(0.45),
    // glockenspiel doubles it an octave up
    note(`<[~ e5@2 d5@2 a4 e5 e5] [f#5 d5@3 b4 b4 e5 e5] [f#5@2 d5@3 b4 c#5 d5] [c#5 b4@5 f#5@2]
           [~ e5@4 b4 f#5 g5] [f#5 e5@4 d5 c#5 d5] [c#5 c#5@2 d5@2 c#5@2 a4] [~ c#5@2 a4@5]
           [~ ~ a5@3 a4 ~ ~] [~ ~ a4 b4 c#5 d5 e5@2] [d5@2 b4@6] [~ ~ a5 f#5 d5 b4 g4@2]
           ~ [~ ~ b5 g5 e5 c#5 a4@2] ~ [~ ~ g4 f#4 e4 ~ d4@2]>`).transpose(12)
      .s("glockenspiel").room(0.5).gain(0.16).pan(0.7),
    // pulse arp
    chord("<D D Bm Bm Em Em A A>").voicing().arp("updown").segment(8)
      .s("pulse").width(0.3).decay(0.1).sustain(0).lpf(2200).gain(0.1).pan(0.3),
    // choir
    chord("<D D Bm Bm Em Em A A>").voicing().s("wt_choir")
      .attack(0.3).release(1.2).lpf(1800).room(0.6).gain(0.16),
    // radio static on the last beat of the section
    s("<~@15 [~ ~ ~ white]>").bpf(1800).bandq(6).coarse(6).decay(0.12).sustain(0).gain(0.12).pan(0.8)
  ),
  verse2: stack(
    s("bd ~ ~ bd ~ ~ ~ ~").bank("RolandTR808").gain(0.75),
    s("~ ~ rim ~ ~ ~ rim ~").bank("RolandTR808").gain(0.3).pan(0.55),
    note("<[d1 d2]*4 [d1 d2]*4 [b0 b1]*4 [b0 b1]*4 [e1 e2]*4 [e1 e2]*4 [a0 a1]*4 [a0 a1]*4>")
      .s("sawtooth").lpf(460).lpenv(1.0).decay(0.12).sustain(0.25)
      .gain("0.24 0.38 0.38 0.24 0.38 0.38 0.38 0.38"),
    // the verse on epiano
    note("<[~ e5 d5 ~ d5 a5@3] [f#5 [~ e5] d5@4 e5 e5] [e5 e5 d5@2 d5 b5 b5@2] [f#5@2 e5@2 d5@3 f#5] [[b4 d5] ~ e5@4 f#5 f#5] [f#5 d5 e5@4 c#5 d5] [c#5 [d5 c#5] d5@2 c#5 ~ d5 c#5] [b4 a4@7]>")
      .s("gm_epiano1").release(0.5).delay(0.4).delaytime(0.489).delayfeedback(0.45)
      .room(0.5).gain(0.3).pan(0.45),
    // pulse arp in quarters
    chord("<D D Bm Bm Em Em A A>").voicing().arp("up").segment(4)
      .s("pulse").width(0.25).decay(0.1).sustain(0).lpf(1800).gain(0.1).pan(0.7),
    chord("<D D Bm Bm Em Em A A>").voicing().s("gm_pad_warm")
      .attack(1.0).release(2.0).lpf(800).room(0.6).gain(0.2),
    // radio static on the last beat of the section
    s("<~@7 [~ ~ ~ white]>").bpf(1800).bandq(6).coarse(6).decay(0.12).sustain(0).gain(0.12).pan(0.8)
  ),
  refrain: stack(
    s("bd ~ ~ bd ~ ~ ~ ~").bank("RolandTR808").gain(0.75),
    s("~ ~ rim ~ ~ ~ rim ~").bank("RolandTR808").gain(0.3).pan(0.55),
    s("hh*8").bank("RolandTR808").gain(0.12).pan(0.4),
    note("<[d1 d2]*4 [d1 d2]*4 [b0 b1]*4 [b0 b1]*4 [e1 e2]*4 [e1 e2]*4 [a0 a1]*4 [a0 a1]*4>")
      .s("sawtooth").lpf(500).lpenv(1.2).decay(0.12).sustain(0.25)
      .gain("0.24 0.38 0.38 0.24 0.38 0.38 0.38 0.38"),
    // the chorus on tubular bells
    note(`<[~ e5@2 d5@2 a4 e5 e5] [f#5 d5@3 b4 b4 e5 e5] [f#5@2 d5@3 b4 c#5 d5] [c#5 b4@5 f#5@2]
           [~ e5@4 b4 f#5 g5] [f#5 e5@4 d5 c#5 d5] [c#5 c#5@2 d5@2 c#5@2 a4] [~ c#5@2 a4@5]>`)
      .s("tubularbells").room(0.7).roomsize(0.8).gain(0.28).pan(0.55),
    chord("<D D Bm Bm Em Em A A>").voicing().s("wt_choir")
      .attack(0.6).release(1.5).lpf(1400).room(0.7).gain(0.18),
    // radio static on the last beat of the section
    s("<~@7 [~ ~ ~ white]>").bpf(1800).bandq(6).coarse(6).decay(0.12).sustain(0).gain(0.12).pan(0.8)
  ),
  bridge: stack(
    // strings, slow and low-passed
    chord("<D D Bm Bm Em Em A A>").voicing().s("gm_string_ensemble_1")
      .attack(1.5).release(2.5).lpf(sine.range(700, 1500).slow(16)).room(0.7).gain(0.22),
    note("<d1 d1 b0 b0 e1 e1 a0 a0>").s("sine").attack(0.8).release(1.5).gain(0.34),
    // arp in 8ths
    chord("<D D Bm Bm Em Em A A>").voicing().arp("<up updown>").segment(8)
      .s("wt_pluck").decay(0.15).sustain(0).lpf(sine.range(1000, 2600).slow(16))
      .delay(0.3).delaytime(0.489).delayfeedback(0.4).room(0.5).gain(0.15).pan(0.6),
    // the riff on bells, half time, second half only
    note(`<~@8 [a5 ~ ~ ~ a4 ~ ~ ~] [a4 ~ c#5 ~ e5 ~ ~ ~] [d5 ~ b4 ~ ~ ~ ~ ~] [a5 ~ f#5 ~ d5 ~ b4 ~]
           [g4 ~ ~ ~ ~ ~ ~ ~] [b5 ~ g5 ~ e5 ~ c#5 ~] [a4 ~ ~ ~ ~ ~ ~ ~] [g4 ~ f#4 ~ e4 ~ ~ ~]>`)
      .s("wt_bell").delay(0.4).delaytime(0.489).delayfeedback(0.4).room(0.7).gain(0.2).pan(0.4),
    // morse ping on bar 1
    note("<[c7 c7 ~ c7 c7 c7 ~ ~] ~@15>").s("square").decay(0.03).sustain(0).hpf(2000).gain(0.08).pan(0.25),
    // radio static on the last beat of the section
    s("<~@15 [~ ~ ~ white]>").bpf(1800).bandq(6).coarse(6).decay(0.12).sustain(0).gain(0.12).pan(0.8)
  ),
  outro: stack(
    // pulse for four bars, then gone
    note("<[d1 d2]*4 [d1 d2]*4 [b0 b1]*4 [b0 b1]*4 ~@12>")
      .s("sawtooth").lpf(isaw.range(460, 200).slow(4)).decay(0.12).sustain(0.2).gain(0.34),
    chord("<D D Bm Bm Em Em A A D D Bm Bm Em A D D>").voicing().s("gm_pad_warm")
      .attack(1.5).release(3.0).lpf(isaw.range(900, 400).slow(16)).room(0.8).gain(0.22),
    note("<d1 d1 b0 b0 e1 e1 a0 a0 d1 d1 b0 b0 e1 a0 d1 d1>").s("sine").attack(0.8).release(2.0).gain(0.32),
    // one bell: the chorus, the first line again, the riff's last fall, home
    note(`<[~ e5@2 d5@2 a4 e5 e5] [f#5 d5@3 b4 b4 e5 e5] [f#5@2 d5@3 b4 c#5 d5] [c#5 b4@5 f#5@2]
           [~ e5@4 b4 f#5 g5] [f#5 e5@4 d5 c#5 d5] [c#5 c#5@2 d5@2 c#5@2 a4] [~ c#5@2 a4@5]
           [~ e5@2 d5@2 a4 e5 e5] [f#5 d5@3 b4 b4 e5 e5] [f#5@2 d5@3 b4 c#5 d5] [c#5 b4@5 ~@2]
           [~ ~ b5 g5 e5 c#5 a4@2] [~ ~ g4 f#4 e4 ~ d4@2] d5 ~>`)
      .s("tubularbells").room(0.85).roomsize(0.9).gain(0.28).pan(0.55),
    // morse ping on bar 1
    note("<[c7 c7 ~ c7 c7 c7 ~ ~] ~@15>").s("square").decay(0.03).sustain(0).hpf(2000).gain(0.08).pan(0.25)
  )
})
